{
  "name": "md-to-comic",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:worker": "wrangler dev workers/api/index.ts --port 8787",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:worker\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "hono": "^4.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}
